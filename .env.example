# Local development only — copy to .env and replace placeholders.
# Never commit a populated .env or real credentials.

# Runtime environment — controls error detail and logging verbosity.
# Valid values:
#   development  — verbose error responses, stack traces exposed, source maps active.
#   production   — sanitized error responses, no stack traces exposed to clients.
#   test         — used by Jest; suppresses console output during test runs.
# Azure: set NODE_ENV=production in azurerm_linux_web_app → app_settings.
NODE_ENV=development

# TCP port the Express server listens on.
PORT=3000

# PostgreSQL connection settings for companymaster and companywebservice tables.
PG_HOST=<pg-host>
PG_PORT=5432
PG_DATABASE=<pg-database>
PG_USER=<pg-user>
PG_PASSWORD=<pg-password>

# Set to true when connecting to a managed cloud PostgreSQL instance that requires SSL.
PG_SSL=false

# Client credentials for ODG API OAuth — shared across all companies.
ODG_API_CLIENT_ID=<odg-api-client-id>
ODG_API_CLIENT_SECRET=<odg-api-client-secret>

# Base URL of the ODG API v1.2.
ODG_API_BASE_URL=https://api.odgbymcg.com

# Sent as the X-ApiVersion header on every upstream request.
ODG_API_VERSION=1.2

# OAuth 2.0 token endpoint used to obtain per-company client-credentials tokens.
OAUTH_TOKEN_URL=<oauth_token_endpoint>

# OAuth grant type — always client_credentials for machine-to-machine auth.
OAUTH_GRANT_TYPE=client_credentials

# Optional OAuth audience claim sent in the token request body.
# Required by some authorization servers (e.g. Auth0, Azure AD) to scope the token to a
# specific API resource. If the auth server does not require an audience, leave this unset
# or as the placeholder — the token request will omit the audience field entirely.
# Example (Auth0): https://api.odgbymcg.com
# Example (Azure AD): api://<application-client-id>
OAUTH_AUDIENCE=<audience_if_required>

# Optional space-delimited OAuth scopes sent in the token request body.
# Restricts the permissions granted to the returned token. If the auth server grants all
# permissions for the client by default (common in machine-to-machine flows), leave this
# unset or as the placeholder — the token request will omit the scope field entirely.
# Example (single scope):  odg-api:read
# Example (multiple):      odg-api:read odg-api:formulary
OAUTH_SCOPES=<space_delimited_scopes_if_required>

# Seconds before a cached token's actual expiry at which it is proactively refreshed.
# Prevents a window where a token appears valid in the cache but expires before the upstream
# ODG API call completes. The effective skew is capped at 10% of the token's total lifetime
# (min(OAUTH_TOKEN_EXPIRY_SKEW_SECONDS, 0.10 * expires_in)) so it never consumes more than
# 10% of a short-lived token. The default of 60 seconds is appropriate for tokens with a
# 3600 s (1 h) or longer lifetime. Raise to 120–300 s for extra safety on high-latency
# deployments; lower to 10–30 s only if tokens are very short-lived (< 5 min).
OAUTH_TOKEN_EXPIRY_SKEW_SECONDS=60

# Absolute path to the read-only PHP CodeIgniter reference checkout — development use only.
# Never required at runtime in production.
LEGACY_PHP_REFERENCE_ROOT=C:\Saurabh\MyApps\Apache24\odgci_3.1.11

# Set to Y to log incoming legacy request URLs, outgoing ODG API URLs, and response bodies.
# Development only — never enable in production; responses may contain medical data.
ODG_DEBUG_PAYLOADS=N

# When Y, every authenticated legacy request is written to the webserviceusage table.
# Requires the table to exist (run data/01-create-db.js first).
USAGE_LOGGING_ENABLED=N

# Maximum number of lines printed per response payload when ODG_DEBUG_PAYLOADS=Y.
# Prevents console flooding for large bulk responses (e.g. NDC download).
PAYLOAD_DUMP_ROW_LIMIT=100

# ---------------------------------------------------------------------------
# Comparison test scripts (api-tester/tests-scripts) — not used at runtime.
# ---------------------------------------------------------------------------

# Base URL of the current live legacy PHP API that the adapter is replacing.
# Used by compare-*.js scripts to call the original endpoint for side-by-side comparison.
LEGACY_API_BASE_URL=http://legacy-host

# Base URL of the new Express adapter under test.
# Used by compare-*.js scripts as the target endpoint to compare against legacy.
ADAPTER_API_BASE_URL=http://localhost:3000

# X-ODG-KEY sent by compare-*.js scripts on every request to both legacy and adapter.
# The same key must be provisioned in both environments for a valid side-by-side comparison.
COMPARE_API_KEY=<your-api-key>

# When set to Y, the UR Advisor comparison script (compare-ur-advisor.js) compares
# 'name' and 'proctype' fields case-insensitively. Useful when legacy and adapter
# return the same text in different casing (e.g. "Sprain" vs "sprain").
TAO_IGNORE_CASE=Y

# Number of leading characters to compare for 'name' fields in UR Advisor responses.
# When set, only the first N characters of each name value are compared so that
# adapter names that extend beyond the legacy-truncated length are not flagged.
# Leave blank (or omit) to compare the full legacy name length as the limit.
TAO_NAME_COMPARE_LENGTH=5

# When set to Y, the One Search comparison script (compare-one-search.js) compares
# 'name' fields case-insensitively. Useful when legacy and adapter return the same
# text in different casing (e.g. "Diabetes Mellitus" vs "Diabetes mellitus").
SEARCH_IGNORE_CASE=Y

# Number of leading characters to compare for 'name' fields in One Search responses.
# When set, only the first N characters of each name value are compared so that
# adapter names that extend beyond the legacy-truncated length are not flagged.
# Leave blank (or omit) to compare the full legacy name length as the limit.
SEARCH_NAME_COMPARE_LENGTH=5

# When set to Y, the Comorbidity Calculator comparison script (compare-comorbidity-calculator.js)
# skips comparison of the odgurl and deeplinkurl fields. Set this when the adapter and legacy
# produce functionally equivalent URLs but with different parameter ordering or encoding,
# to avoid false failures on URL string differences that do not affect correctness.
CALC_SKIP_URL_COMPARE=Y

# Number of leading characters to compare for 'name' fields in Calculator responses
# (both compare-comorbidity-calculator.js and compare-reserve-calculator.js).
# When set, only the first N characters of each name value are compared so that
# adapter names that extend beyond the legacy-truncated length are not flagged.
# Leave blank (or omit) to compare the full name value.
CALC_NAME_COMPARE_LENGTH=5

# Numeric tolerance for calculator value comparisons
# (both compare-comorbidity-calculator.js and compare-reserve-calculator.js).
# When set to a positive number, differences in riskassessment.score,
# adjustedduration days (bp/cp95/cp100), and all adjustedsummaryguidelines child
# values within this absolute range are reported as WITHIN_THRESHOLD instead of
# CONTENT_MISMATCH and do not count as failures. Leave blank to require exact matches.
CALC_VARIANCE_THRESHOLD=

# ---------------------------------------------------------------------------
# MySQL log database (generate-customer-test-inputs.js only — not a runtime dependency).
# ---------------------------------------------------------------------------

# Hostname or IP address of the MySQL server containing the customer request log.
MYSQL_HOST=<mysql-host>

# TCP port the MySQL server listens on.
MYSQL_PORT=3306

# MySQL user account used to connect (read-only access is sufficient).
MYSQL_USER=<mysql-user>

# Password for the MySQL user account above.
MYSQL_PASSWORD=<mysql-password>

# Name of the MySQL database that contains the log table and stored procedures.
MYSQL_DATABASE=<mysql-database>

# ---------------------------------------------------------------------------
# Azure Deployment Notes (Terraform / App Service)
# ---------------------------------------------------------------------------
# Every variable above maps to an Azure App Service Application Setting.
# Set them under azurerm_linux_web_app → app_settings { ... } in Terraform.
#
# Required Azure resources:
#   azurerm_resource_group                    — logical container
#   azurerm_service_plan                      — B1+ for always-on
#   azurerm_linux_web_app                     — Node.js Express host
#     site_config {
#       app_command_line = "node dist/server.js"
#       health_check_path = "/health"
#     }
#   azurerm_postgresql_flexible_server        — PostgreSQL 14+
#   azurerm_postgresql_flexible_server_database
#   azurerm_key_vault + azurerm_key_vault_secret
#   azurerm_application_insights              — telemetry (recommended)
#   azurerm_virtual_network + private endpoints (recommended)
#
# Sensitive values — store in Key Vault, reference in app_settings as:
#   "@Microsoft.KeyVault(SecretUri=https://<vault>.vault.azure.net/secrets/<name>/)"
#   • PG_PASSWORD         → Key Vault secret: pg-password
#   • ODG_API_CLIENT_SECRET → Key Vault secret: odg-api-client-secret
#
# Production-specific overrides:
#   PORT=8080             (App Service injects WEBSITES_PORT; set PORT=8080 in app_settings)
#   NODE_ENV=production
#   PG_HOST=<azurerm_postgresql_flexible_server.fqdn>
#   PG_SSL=true           (required — Azure Flexible Server enforces SSL)
#   ODG_DEBUG_PAYLOADS=N  (must be N — responses contain medical data)
#   USAGE_LOGGING_ENABLED=Y
#
# Omit from Azure app_settings entirely:
#   LEGACY_PHP_REFERENCE_ROOT  (dev-only PHP reference path)
#   MYSQL_*                    (dev-only test script variables)
